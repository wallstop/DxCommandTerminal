{
  "name": "dxcommandterminal-tooling",
  "private": true,
  "description": "npm tooling for the DxCommandTerminal repository. Lives under tooling~/ (tilde-suffixed) so Unity never imports it or its node_modules when the repository is used as a local package. The root UPM package.json delegates here via `npm --prefix tooling~`.",
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "test": "node --test \"scripts/mcp/__tests__/*.test.mjs\" \"scripts/tests/*.test.mjs\"",
    "package:validate": "node scripts/release/validate-package-contents.mjs",
    "package:export": "node scripts/release/export-unitypackage.mjs",
    "lint:comparison-direction": "node scripts/lint-comparison-direction.mjs",
    "lint:comparison-direction:fix": "node scripts/lint-comparison-direction.mjs --fix",
    "lint:member-ordering": "node scripts/lint-member-ordering.mjs --verbose",
    "lint:member-ordering:fix": "node scripts/lint-member-ordering.mjs --fix",
    "lint:multiline-comments": "node scripts/lint-multiline-comments.mjs",
    "lint:multiline-comments:fix": "node scripts/lint-multiline-comments.mjs --fix",
    "lint:linq-production": "node scripts/lint-linq-production.mjs",
    "lint:string-equality": "node scripts/lint-string-equality.mjs",
    "lint:theme-palette-tokens": "node scripts/lint-theme-palette-tokens.mjs",
    "unity:mcp:probe": "node scripts/mcp/unity-mcp.mjs probe",
    "unity:mcp:configure": "node scripts/mcp/unity-mcp.mjs configure",
    "unity:mcp:bridge": "node scripts/mcp/unity-mcp.mjs bridge",
    "unity:mcp:install-capture": "node scripts/mcp/unity-mcp.mjs install-capture",
    "unity:capture": "node scripts/mcp/unity-mcp.mjs capture",
    "ai:backends": "bash ../.devcontainer/ai-backends.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0"
  }
}
