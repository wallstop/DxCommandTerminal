# DxCommandTerminal local credentials and host-path overrides.
# Copy to .env.local (gitignored) and fill in what you use. Values here are
# documentation only; the tooling reads .env.local, never this file.
# Precedence: process environment > .env.local. Empty env vars are ignored.
# .env.local is parsed directly by the claude-zai/codex-zai/
# claude-openrouter/codex-openrouter launchers and the MCP config generator.
# Post-create installs an interactive shell autoload for native agents.
# Non-interactive callers can evaluate `.devcontainer/ai-backends.sh env`.

# --- Z.AI (GLM coding plan / API) -------------------------------------------
# Used by claude-zai, codex-zai, native opencode (via the ZHIPU_API_KEY mirror
# from `ai-backends.sh env`), and the four Z.AI MCP servers.
ZAI_API_KEY=your_zai_key
# Z_AI_API_KEY=also_accepted

# --- OpenRouter (claude-openrouter / codex-openrouter) ------------------------
# Single key for any OpenRouter model; model selection via CLAUDE_OPENROUTER_*
# and CODEX_OPENROUTER_MODEL environment variables (see .devcontainer/README.md).
OPENROUTER_API_KEY=your_openrouter_key

# --- GitHub (github MCP server, gh CLI) --------------------------------------
GITHUB_TOKEN=your_github_token
# GITHUB_PERSONAL_ACCESS_TOKEN=, GH_TOKEN=, GITHUB_PAT= also accepted.

# --- Unity MCP bridge ---------------------------------------------------------
# Absolute host path to the Unity project that embeds this package (bridge runs
# on the host with this project open). The bridge port defaults to a
# deterministic per-project port in 27100..27999; override only on collision.
UNITY_PROJECT_PATH=/absolute/host/project/path
# The devcontainer sets this to /unity-project for local capture-file writes.
# UNITY_PROJECT_CONTAINER_PATH=/unity-project
# UNITY_MCP_BRIDGE_PORT=27444
# UNITY_MCP_BRIDGE_HOST=host.docker.internal
