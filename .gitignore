# NPM
node_modules/

# npm lockfiles are intentionally not committed for Unity packages (reviewer
# decision): the package ships no Node code, and a lockfile would churn with
# every dev environment. Install with `npm --prefix tooling~ install` to work on the tooling (the npm
# project lives under tooling~/ so Unity never imports node_modules).
package-lock.json

# Local credentials - never commit (preferred credential source; see .env.example)
.env.local
.env.*.local

# Tooling artifacts (Unity state captures, scratch outputs)
.artifacts/

# Generated agent MCP configs (written by `npm run unity:mcp:configure`, contain tokens)
.mcp.json
opencode.jsonc
# Unity regenerates these stubs for gitignored targets on local/embedded opens;
# committing them would trip the orphan-meta half of the meta lint (issue #39)
opencode.jsonc.meta
node_modules.meta
.codex/
.cursor/mcp.json
.copilot/
.nanocoder/
.vscode/mcp.json

# macOS
.DS_Store

# Session work logs (local only)
GOAL.md*
progress/
progress.meta

# DotNet build outputs under the Unity-hidden generator directory
Generator~/**/bin/
Generator~/**/obj/

# Docs site build state (docfx project under tooling~/docs; rebuilt by npm run docs:build)
tooling~/docs/obj/
